// Computational benchmark, prefix2k variant (prefill vs decode balance): one complex single-prompt program exercising every
// evaluation path — forced text scoring (header + inputs), repeated bounded
// completions (work), a long completion (summary), and choice scoring
// (answer) — under whatever search parameters the sweep supplies.

prompt main {
  is {
    topic is text<length=20>;
    question is text<length=50>;
    choices[4] is text<length=40>;
    work[1:8] is text<length=25>;
    summary is text<length=50>;
    answer is select(choices);
  }
  channel {
    topic get topic;
    question get question;
    choices get choices;
  }
  return {
    use answer;
  }
