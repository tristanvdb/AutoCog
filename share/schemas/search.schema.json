{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search.schema.json",
  "title": "AutoCog Search Configuration",
  "description": "Concrete default search parameters per category (text, enum, branch, flow, queue). These mirror what xfta implements and provide the fallback values used when a program's search policy does not set a parameter.",
  "type": "object",
  "properties": {
    "metadata": {
      "allOf": [
        { "$ref": "common/metadata.schema.json" },
        { "properties": { "format": { "const": "search" } } }
      ],
      "unevaluatedProperties": false
    },
    "text": {
      "type": "object",
      "description": "Defaults for `complete` (text) actions.",
      "properties": {
        "threshold":  { "type": "number", "description": "Probability threshold for pruning." },
        "beams":      { "type": "integer", "minimum": 0, "description": "Number of beams (0 = disabled)." },
        "topk":       { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "Candidate tokens sampled per beam expansion (null = same as beams)." },
        "ahead":      { "type": "integer", "minimum": 0, "description": "Look-ahead depth (0 = disabled)." },
        "width":      { "type": "integer", "minimum": 1, "description": "Beam width." },
        "repetition": { "oneOf": [{ "type": "number" }, { "type": "null" }], "description": "Repetition penalty (null = disabled)." },
        "diversity":  { "oneOf": [{ "type": "number" }, { "type": "null" }], "description": "Diversity penalty (null = disabled)." }
      },
      "required": ["threshold", "beams", "ahead", "width"],
      "additionalProperties": false
    },
    "enum":   { "$ref": "#/$defs/choice", "description": "Defaults for enum-content `choose` actions." },
    "branch": { "$ref": "#/$defs/choice", "description": "Defaults for record-successor branch `choose` actions." },
    "flow":   { "$ref": "#/$defs/choice", "description": "Defaults for the flow / next `choose` action." },
    "queue": {
      "type": "object",
      "description": "Prompt-scope queue parameters: exploration order and early termination.",
      "properties": {
        "metric": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ],
          "description": "Lexicographic ordering keys (perplexity, probability, shortest, longest, shallowest, deepest, near_leaf, far_leaf, fifo); a bare string is a one-element list; fifo is the implicit final tie-break."
        },
        "stop": {
          "oneOf": [ { "$ref": "#/$defs/term" }, { "type": "null" } ],
          "description": "Early-termination predicate; null/absent = run the queue to exhaustion."
        }
      },
      "required": ["metric"],
      "additionalProperties": false
    }
  },
  "required": ["text", "enum", "branch", "flow", "queue"],
  "additionalProperties": false,
  "$defs": {
    "choice": {
      "type": "object",
      "properties": {
        "threshold": { "type": "number", "description": "Probability threshold." },
        "width":     { "type": "integer", "minimum": 1, "description": "Top-k width." }
      },
      "required": ["threshold", "width"],
      "additionalProperties": false
    },
    "term": {
      "description": "Termination predicate: a single-key object — all/any of sub-predicates, not of one, or a comparison [scalar-name, constant] with ge/gt/le/lt. Scalars: terminals, coverage.fta, coverage.sta, best.proba, mean.proba, std.proba, best.zscore, tokens, queue.size, seconds.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/$defs/term" }, "minItems": 1 },
        "any": { "type": "array", "items": { "$ref": "#/$defs/term" }, "minItems": 1 },
        "not": { "$ref": "#/$defs/term" },
        "ge":  { "$ref": "#/$defs/cmp" },
        "gt":  { "$ref": "#/$defs/cmp" },
        "le":  { "$ref": "#/$defs/cmp" },
        "lt":  { "$ref": "#/$defs/cmp" }
      },
      "additionalProperties": false
    },
    "cmp": {
      "type": "array",
      "prefixItems": [ { "type": "string" }, { "type": "number" } ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
