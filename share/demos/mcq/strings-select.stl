// MCQ over a list of strings, committing by INDEX.
//
// The model emits the position of the choice it picks, so the frame records a
// digit. Turning that digit into the choice it names is this program's job,
// done on the return — which is why the runtime never rewrites the field.

from "mcq.py" import pick;

// Program-scope so `-D index_label=...` can set it: -D binds the
// PROGRAM's arguments, while a prompt's `argument` is the prompt's
// own parameter. Empty by default -- a description that names an
// index base must agree with prompt_zero_index, and nothing here can
// see the syntax yet.
argument index_label = "";

prompt main {
  argument max_choices = 10;
  is {
    topic is text<length=20>;
    question is text<length=50>;
    choices[2:max_choices] is text<length=40>;
    answer is select(choices);
  }
  channel {
    topic get topic;
    question get question;
    choices get choice.value;
  }
  return call pick _ { zero_index use __syntax__.prompt_zero_index; };
  annotate {
    _ as "You are answering a multiple choice questionnaire.";
    topic as "the general category from which the question was taken";
    question as "the question that you have to answer";
    choices as "the possible choices to answer the question, only one is correct";
    answer as f"you pick the index of the choice that best answer the question{index_label}";
  }
}

export main<> as main;
