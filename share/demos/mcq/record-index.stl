// MCQ over labelled records, committing by INDEX.
//
// Same commitment as strings-select — a digit naming a position — but the
// choices carry a label alongside their text, so the index names a record and
// the answer is that record's value.

from "record.stl" import a_choice;
from "mcq.py" import pick_value;

prompt main {
  argument max_choices = 10;
  is {
    topic is text<length=20>;
    question is text<length=50>;
    choice[2:max_choices] is a_choice;
    answer is select(choice);
  }
  channel {
    topic get topic;
    question get question;
    choice get choice;
  }
  return call pick_value _;
  annotate {
    _ as "You are answering a multiple choice questionnaire.";
    topic as "the general category from which the question was taken";
    question as "the question that you have to answer";
    choice as "the possible choices to answer the question, only one is correct";
    answer as "you pick the index of the choice that best answer the question";
  }
}

export main<> as main;
