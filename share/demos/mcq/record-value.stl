// MCQ over labelled records, committing by TEXT.
//
// The label is rendered beside each choice but the model commits on the value,
// so the labels are context it can see and not use. What it emits is the
// answer; the return hands the field over unchanged.

from "record.stl" import choice;

prompt main {
  argument max_choices = 10;
  is {
    topic is text<length=20>;
    question is text<length=50>;
    choices[2:max_choices] is choice;
    answer is repeat(choices.value);
  }
  channel {
    topic get topic;
    question get question;
    choices get choices;
  }
  return {
    use answer;
  }
  annotate {
    _ as "You are answering a multiple choice questionnaire.";
    topic as "the general category from which the question was taken";
    question as "the question that you have to answer";
    choices as "the possible choices to answer the question, only one is correct";
    answer as "you repeat verbatim the choice that best answer the question";
  }
}

export main<> as main;
