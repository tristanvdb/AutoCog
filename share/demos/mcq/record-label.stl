// MCQ over labelled records, committing by LABEL.
//
// A single-token commitment like strings-select, but on the letter the choice
// carries rather than on its position. `repeat(choices.label)` ranks the
// labels present in the record, so an out-of-range letter is not something the
// model can emit — the choice set IS the data. The label is then resolved to
// the value it names, on the return.

from "record.stl" import choice;
from "mcq.py" import by_label;

prompt main {
  argument max_choices = 10;
  is {
    topic is text<length=20>;
    question is text<length=50>;
    choices[2:max_choices] is choice;
    answer is repeat(choices.label);
  }
  channel {
    topic get topic;
    question get question;
    choices get choices;
  }
  return call by_label _;
  annotate {
    _ as "You are answering a multiple choice questionnaire.";
    topic as "the general category from which the question was taken";
    question as "the question that you have to answer";
    choices as "the possible choices to answer the question, only one is correct";
    answer as "you give the letter labelling the choice that best answer the question";
  }
}

export main<> as main;
