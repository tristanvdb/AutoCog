// Importing (and calling) a prompt that internally uses defines imported
// from a third file — without importing those defines here.

from "test_define_user_lib.stl" import refine;

prompt main {
  is {
    got[1:3] is text<length=12>;
  }
  channel {
    got call refine {
      seed get seed;
    } bind(_,response);
  }
  return {
    use got;
  }
}

export main;
