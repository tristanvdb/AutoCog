{
  "name": "testing",
  "defaults": {
    "seed": 42,
    "questions": 2
  },
  "worker": {
    "mode": "distributed",
    "factor": 2
  },
  "models": [
    {
      "model": "tiny-llama3-test-Q2_K",
      "ctx": 1024
    }
  ],
  "datasets": [
    "questions"
  ],
  "phases": [
    {
      "name": "smoke",
      "runs": [
        {
          "kind": "quality",
          "data": "questions",
          "syntaxes": [
            "complete"
          ],
          "out": "rng-select",
          "programs": {
            "strings-select": {
              "filepath": "autocog/share/demos/mcq/strings-select.stl",
              "labels": [
                "select",
                "strings"
              ]
            }
          }
        },
        {
          "kind": "quality",
          "model": "tiny-llama3-test-Q2_K",
          "data": "questions",
          "syntaxes": [
            "complete"
          ],
          "out": "tiny-select",
          "programs": {
            "strings-select": {
              "filepath": "autocog/share/demos/mcq/strings-select.stl",
              "labels": [
                "select",
                "strings"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "probes",
      "runs": [
        {
          "kind": "probe",
          "model": "tiny-llama3-test-Q2_K",
          "demo": "strings-repeat",
          "syntax": "complete",
          "data": "questions",
          "limit": 2,
          "out": "tiny-probe"
        }
      ]
    },
    {
      "name": "termination",
      "runs": [
        {
          "kind": "perf",
          "cells": "termination",
          "budget_seconds": 60,
          "tag": "rng-term",
          "out": "rng-term"
        }
      ]
    }
  ],
  "axes": [
    "model",
    "syntax",
    "program"
  ],
  "programs": {
    "strings-select": {
      "filepath": "autocog/share/demos/mcq/strings-select.stl",
      "labels": [
        "select",
        "strings"
      ]
    },
    "strings-repeat": {
      "filepath": "autocog/share/demos/mcq/strings-repeat.stl",
      "labels": [
        "repeat",
        "strings"
      ]
    }
  }
}